<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AirSense" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/airsense_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/airsense_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/airsense_primary</item>
        <item name="android:windowBackground">@color/airsense_bg_light</item>
    </style>

    <style name="Theme.AirSense" parent="Base.Theme.AirSense" />

    <!-- SplashScreen API Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/airsense_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AirSense</item>
    </style>
</resources>