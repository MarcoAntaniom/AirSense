<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AirSense" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/airsense_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/airsense_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/airsense_primary</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AirSense" parent="Base.Theme.AirSense" />

    <!-- Bottom Navigation Pill Indicator -->
    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/airsense_secondary_light</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- SplashScreen API Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/airsense_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AirSense</item>
    </style>
</resources>